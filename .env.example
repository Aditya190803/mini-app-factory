# Mini App Factory environment. Copy to .env.local and fill in.
# See REQUIREMENTS.md for where each value comes from.

# --- Required ---------------------------------------------------------------

# Public origin, used for OAuth redirects, the sitemap, and share cards.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex (`bun convex dev` prints these)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Stack Auth
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Encrypts stored integration tokens and BYOK keys. 32+ characters:
#   openssl rand -base64 48
INTEGRATION_TOKEN_SECRET=

# --- AI providers (at least one) ---------------------------------------------

AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_FALLBACK_MODEL=

# --- Cloudflare (the default deploy target) ---------------------------------

CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
# Optional. Leave unset to use the defaults in lib/cloudflare-oauth.ts.
CLOUDFLARE_OAUTH_SCOPES=

# --- Optional -----------------------------------------------------------------

# Comma-separated. Also set on the Convex deployment:
#   npx convex env set MAF_ADMIN_EMAILS you@example.com
MAF_ADMIN_EMAILS=

# GitHub mirror, and Netlify hosting on top of it
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=

# "Reference a site" in the composer
EXA_API_KEY=
